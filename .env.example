# Configuration template only. Never commit real credentials.
# Database connections load .env without overriding existing environment variables.

# Claude API key from https://console.anthropic.com. Leave empty on a public demo.
ANTHROPIC_API_KEY=
# Optional model override; the code default is claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# PostgreSQL connection (Neon, Supabase or TigerData).
# Auth and persistence must use the same database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSLMODE=require
