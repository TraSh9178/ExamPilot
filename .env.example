# Configuration template only. Never commit real credentials.
# Database connections load the project .env without overriding existing env vars.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Supabase: copy your PostgreSQL connection string from Connect.
# Use the session pooler when your hosting environment only supports IPv4.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSLMODE=require
